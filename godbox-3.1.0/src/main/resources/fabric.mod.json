  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.vladik.godbox.GodBox"],
    "client": ["com.vladik.godbox.client.GodBoxClient"]
  },
  "mixins": ["godbox.mixins.json"],
  "accessWidener": "godbox.accesswidener",
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
